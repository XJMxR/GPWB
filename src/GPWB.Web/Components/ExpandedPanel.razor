@using Microsoft.AspNetCore.Components.Web

<div class="expanded-panel-overlay" 
     @onpointerdown:stopPropagation="true" 
     @onwheel:stopPropagation="true"
     role="dialog" 
     aria-modal="true" 
     aria-labelledby="expanded-panel-title">
    <section class="expanded-panel">
        <header class="expanded-panel-header">
            <div class="expanded-panel-heading">
                <span class="card-icon @IconClass" aria-hidden="true">@Icon</span>
                <div class="card-heading-text">
                    <span class="card-overline">@Overline</span>
                    <h2 id="expanded-panel-title" class="expanded-panel-title">@Title</h2>
                    <span class="expanded-panel-subtitle">@Description</span>
                </div>
            </div>
            <div class="expanded-panel-actions">
                <a class="expanded-github-link" href="@GitHubUrl" target="_blank" rel="noopener noreferrer">
                    Ver en GitHub ↗
                </a>
                <button class="expanded-close" type="button" @onclick="Close" 
                        aria-label="Cerrar vista ampliada" title="Cerrar (Esc)">×</button>
            </div>
        </header>

        <div class="expanded-panel-body">
            @ChildContent
        </div>
    </section>
</div>

@code {
    [Parameter, EditorRequired]
    public required string Title { get; set; }

    [Parameter, EditorRequired]
    public required string Overline { get; set; }

    [Parameter, EditorRequired]
    public required string Icon { get; set; }

    [Parameter, EditorRequired]
    public required string IconClass { get; set; }

    [Parameter, EditorRequired]
    public required string Description { get; set; }

    [Parameter, EditorRequired]
    public required string GitHubUrl { get; set; }

    [Parameter, EditorRequired]
    public required RenderFragment ChildContent { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private Task Close() => OnClose.InvokeAsync();
}