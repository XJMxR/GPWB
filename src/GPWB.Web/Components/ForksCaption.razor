@using GPWB.Core.Models

<div class="forks-caption">
    <span>
        <i class="fork-caption-dot"></i>
        @Forks.Count forks recientes
    </span>
    <a href="@($"{RepoFullName}/forks")" target="_blank" rel="noopener noreferrer">
        Ver los @Repository.ForksCount.ToString("N0") en GitHub ↗
    </a>
</div>

@code {
    [Parameter, EditorRequired]
    public required IReadOnlyList<GitHubRepository> Forks { get; set; }

    [Parameter, EditorRequired]
    public required GitHubRepository Repository { get; set; }

    [Parameter, EditorRequired]
    public required string RepoFullName { get; set; }
}