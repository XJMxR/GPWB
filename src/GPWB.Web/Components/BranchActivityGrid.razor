@using GPWB.Core.Models

<div class="branch-activity-grid">
    @foreach (var branch in Branches.Take(2))
    {
        <section class="branch-entry" @key="branch.Name">
            <div class="branch-entry-heading">
                <a href="@GetBranchUrl(branch.Name)" target="_blank" rel="noopener noreferrer" title="@branch.Name" class="branch-name">
                    <span class="branch-symbol" aria-hidden="true">⑂</span>
                    <span>@ShortName(branch.Name, 28)</span>
                </a>
                @if (branch.Protected)
                {
                    <span class="protected-branch" title="Rama protegida">PROTEGIDA</span>
                }
            </div>
            @if (branch.Commits.Count == 0)
            {
                <p class="branch-empty">Sin commits recientes.</p>
            }
            else
            {
                <ol class="branch-commit-list">
                    @foreach (var commit in branch.Commits.Take(3))
                    {
                        <li @key="commit.Sha">
                            <span class="branch-commit-dot"></span>
                            <a href="@($"https://github.com/{RepoFullName}/commit/{commit.Sha}")" target="_blank" rel="noopener noreferrer">
                                <span class="branch-commit-message">@ShortName(commit.Commit.Message.Split('\n', 2)[0], 62)</span>
                                <small>
                                    @(commit.Commit.Author?.Name ?? "Autor desconocido")
                                    · @GetCommitAge(commit.Commit.Author?.Date)
                                    · <code>@commit.Sha[..7]</code>
                                </small>
                            </a>
                        </li>
                    }
                </ol>
            }
        </section>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public required IReadOnlyList<GitHubBranchActivity> Branches { get; set; }

    [Parameter, EditorRequired]
    public required string RepoFullName { get; set; }

    private string GetBranchUrl(string branchName) => $"{RepoFullName}/tree/{Uri.EscapeDataString(branchName)}";

    private static string ShortName(string value, int maxLength) => value.Length <= maxLength ? value : $"{value[..(maxLength - 1)]}…";

    private static string GetCommitAge(DateTimeOffset? date)
    {
        if (date is null) return "fecha no disponible";
        var elapsed = DateTimeOffset.UtcNow - date.Value;
        return elapsed.TotalDays switch
        {
            < 1 => "hoy",
            < 30 => $"hace {(int)elapsed.TotalDays} d",
            < 365 => $"hace {(int)(elapsed.TotalDays / 30)} mes",
            _ => $"hace {(int)(elapsed.TotalDays / 365)} a"
        };
    }
}