@using GPWB.Models

<div class="branches-caption">
    Vista previa: dos ramas y tres commits por rama.
    @if (BranchesReturned >= 100)
    {
        <span> GitHub devolvió las primeras 100 ramas.</span>
    }
    <button type="button" class="branches-expand-link" @onclick="OnExpand" @onpointerdown:stopPropagation="true">
        @if (Branches.Count > 2)
        {
            <span>Ver las @Math.Max(0, Branches.Count - 2) restantes y su actividad ↗</span>
        }
        else
        {
            <span>Ver todas las ramas y su actividad ↗</span>
        }
    </button>
</div>

@code {
    [Parameter, EditorRequired]
    public required IReadOnlyList<GitHubBranchActivity> Branches { get; set; }

    [Parameter, EditorRequired]
    public required int BranchesReturned { get; set; }

    [Parameter]
    public EventCallback OnExpand { get; set; }
}