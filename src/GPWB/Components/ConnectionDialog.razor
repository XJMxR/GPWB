@using Microsoft.AspNetCore.Components.Web

<div class="connection-dialog-backdrop" @onclick="Close" tabindex="-1" aria-hidden="true">
    <div class="connection-dialog" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="connection-dialog-title">
        <div class="connection-dialog-heading">
            <h2 id="connection-dialog-title">Conectar cuenta de GitHub</h2>
            <button type="button" class="expanded-close" @onclick="Close" aria-label="Cerrar diálogo">×</button>
        </div>
        <p>
            Un token <strong>fine-grained</strong> aumenta el límite de solicitudes a la API de GitHub
            (hasta 5.000 por hora). El token se usa solo en esta pestaña y se borra al cerrar.
        </p>
        <a class="token-help-link" href="https://github.com/settings/tokens?type=beta" target="_blank" rel="noopener noreferrer">
            Crear token fine-grained en GitHub ↗
        </a>
        <form class="connection-form" @onsubmit="HandleSubmit">
            <label for="token-input">Token personal de acceso</label>
            <div class="input-wrap">
                <span aria-hidden="true">ghp_</span>
                <input id="token-input" type="password" @bind="Token" placeholder="Pega tu token aquí" autocomplete="off" aria-describedby="token-help" />
            </div>
            <span id="token-help" class="connection-security-note">
                El token debe tener acceso <strong>solo lectura a repositorios públicos</strong>.
                RepoCanvas valida que cada repositorio consultado sea público.
            </span>
            <div class="connection-dialog-actions">
                <button type="button" class="secondary-button" @onclick="Close">Cancelar</button>
                <button type="submit" class="primary-button" disabled="@IsConnecting">
                    @if (IsConnecting)
                    {
                        <span class="button-spinner" aria-hidden="true"></span>
                        Conectando...
                    }
                    else
                    {
                        <span>Conectar</span>
                    }
                </button>
            </div>
        </form>
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="error-message">@ErrorMessage</div>
        }
        <p class="connection-security-note">
            El token se envía directamente a <code>api.github.com</code>, nunca a un servidor de RepoCanvas.
            Se elimina al desconectar o recargar la página.
        </p>
    </div>
</div>

@code {
    [Parameter]
    public bool IsOpen { get; set; } = false;

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    [Parameter]
    public EventCallback<string> OnConnect { get; set; }

    [Parameter]
    public bool IsConnecting { get; set; } = false;

    private string Token { get; set; } = string.Empty;
    private string ErrorMessage { get; set; } = string.Empty;

    private async Task HandleSubmit()
    {
        ErrorMessage = string.Empty;
        if (string.IsNullOrWhiteSpace(Token))
        {
            ErrorMessage = "Introduce un token personal de acceso de GitHub.";
            return;
        }

        try
        {
            await OnConnect.InvokeAsync(Token.Trim());
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
    }

    private async Task Close()
    {
        Token = string.Empty;
        ErrorMessage = string.Empty;
        await IsOpenChanged.InvokeAsync(false);
    }
}