@using GPWB.Models

<div class="activity-tree-preview">
    <div class="activity-tree-preview-root">
        <span class="branch-symbol">⑂</span>
        <strong>@DefaultBranch</strong>
        <small>rama predeterminada</small>
    </div>
    <ol class="activity-tree-commits activity-tree-preview-commits">
        @foreach (var commit in Commits.Take(MaxCommits))
        {
            <CommitTreeItem Commit="commit" RepoFullName="RepoFullName" ShowParents="false" />
        }
    </ol>
    <a class="tree-preview-link" 
       href="@($"{RepoFullName}/commits/{Uri.EscapeDataString(DefaultBranch)}")" 
       target="_blank" rel="noopener noreferrer">
        Ver el historial completo ↗
    </a>
</div>

@code {
    [Parameter, EditorRequired]
    public required IReadOnlyList<GitHubCommit> Commits { get; set; }

    [Parameter, EditorRequired]
    public required string RepoFullName { get; set; }

    [Parameter, EditorRequired]
    public required string DefaultBranch { get; set; }

    [Parameter]
    public int MaxCommits { get; set; } = 4;
}