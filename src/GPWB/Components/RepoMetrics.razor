@using GPWB.Models

<div class="repo-metrics">
    <div class="repo-metric">
        <strong>★ @Repository.StargazersCount.ToString("N0")</strong>
        <span>estrellas</span>
    </div>
    <div class="repo-metric">
        <strong>⑂ @Repository.ForksCount.ToString("N0")</strong>
        <span>forks</span>
    </div>
    <div class="repo-metric">
        <strong>@Repository.OpenIssuesCount.ToString("N0")</strong>
        <span>issues + PRs</span>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public required GitHubRepository Repository { get; set; }
}