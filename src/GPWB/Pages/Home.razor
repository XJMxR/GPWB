@page "/"
@using System.Net
@using System.Text.RegularExpressions
@inject IGitHubProjectService ProjectService
@inject IGitHubApiSession ApiSession
@inject IJSRuntime JS

<PageTitle>RepoCanvas — @(_project?.Repository.FullName ?? "tablero de GitHub")</PageTitle>

<div class="app-shell">
    <header class="topbar">
        <a class="brand" href="./" aria-label="RepoCanvas, inicio">
            <span class="brand-mark" aria-hidden="true">R</span>
            <span>repo<span class="brand-accent">canvas</span></span>
        </a>
        <div class="topbar-divider"></div>
        <div class="document-title">
            <span class="document-kicker">TABLERO DE PROYECTO</span>
            <strong>@(_project?.Repository.FullName ?? "Nuevo tablero")</strong>
        </div>
        <div class="topbar-actions">
            @if (_project is not null)
            {
                <a class="github-link" href="@_project.Repository.HtmlUrl" target="_blank" rel="noopener noreferrer">
                    <span aria-hidden="true">↗</span> Ver en GitHub
                </a>
            }
            <span class="api-usage" title="Consultas anónimas enviadas por esta pestaña durante esta sesión. El límite restante lo informa GitHub.">
                @if (ApiSession.Usage.IsAuthenticated)
                {
                    <span class="api-usage-dot connected"></span>
                    <span>GitHub · @ApiSession.Usage.Login</span>
                    @if (ApiSession.Usage.RemainingRequests is int authenticatedRemaining)
                    {
                        <small>@authenticatedRemaining/@ApiSession.Usage.RequestLimit</small>
                    }
                }
                else
                {
                    <span class="api-usage-dot"></span>
                    <span>Anónimas · @ApiSession.Usage.AnonymousRequests</span>
                    @if (ApiSession.Usage.RemainingRequests is int anonymousRemaining)
                    {
                        <small>@anonymousRemaining/@ApiSession.Usage.RequestLimit</small>
                    }
                }
            </span>
            @if (ApiSession.Usage.IsAuthenticated)
            {
                <button class="connect-github-button connected" type="button" @onclick="DisconnectGitHub">
                    Desconectar
                </button>
            }
            else
            {
                <button class="connect-github-button" type="button" @onclick="OpenConnectionDialog">
                    Conectar GitHub
                </button>
            }
        </div>
    </header>

    <div class="workspace">
        <aside class="sidebar">
            <div class="sidebar-heading">
                <div>
                    <span class="eyebrow">FUENTE DE DATOS</span>
                    <h1>Proyecto GitHub</h1>
                </div>
                <span class="source-icon" aria-hidden="true">GH</span>
            </div>
            <p class="sidebar-copy">Explora repositorios públicos. Conecta una cuenta para aumentar el límite de consultas de GitHub.</p>

            <form class="repo-form" @onsubmit="LoadProjectAsync" @onsubmit:preventDefault>
                <label for="repository">Repositorio público: usuario/repositorio</label>
                <div class="input-wrap">
                    <span aria-hidden="true">⌕</span>
                    <input id="repository" @bind="_repositoryInput" placeholder="dotnet / aspnetcore" autocomplete="off" />
                </div>
                <button class="primary-button" type="submit" disabled="@_isLoading">
                    @if (_isLoading)
                    {
                        <span class="button-spinner" aria-hidden="true"></span>
                        <span>Conectando…</span>
                    }
                    else
                    {
                        <span aria-hidden="true">＋</span>
                        <span>Generar tablero</span>
                    }
                </button>
            </form>

            @if (_error is not null)
            {
                <div class="error-message" role="alert">@_error</div>
            }

            @if (_project is not null)
            {
                <div class="sidebar-section">
                    <span class="eyebrow">EN ESTE TABLERO</span>
                    <div class="layer-list">
                        <div class="layer-item"><span class="layer-dot project-dot"></span>Repositorio</div>
                        <div class="layer-item"><span class="layer-dot forks-dot"></span>Red radial de forks</div>
                        <div class="layer-item"><span class="layer-dot branches-dot"></span>Actividad por rama</div>
                        <div class="layer-item"><span class="layer-dot language-dot"></span>Lenguajes</div>
                        <div class="layer-item"><span class="layer-dot issue-dot"></span>Issues abiertos</div>
                        <div class="layer-item"><span class="layer-dot activity-dot"></span>Actividad reciente</div>
                    </div>
                </div>

                <div class="sidebar-section repo-summary">
                    <span class="eyebrow">RESUMEN</span>
                    <div class="summary-line"><span>Estrellas</span><strong>★ @_project.Repository.StargazersCount.ToString("N0")</strong></div>
                    <div class="summary-line"><span>Forks</span><strong>⑂ @_project.Repository.ForksCount.ToString("N0")</strong></div>
                    <div class="summary-line"><span>Ramas analizadas</span><strong>@_project.Branches.Count</strong></div>
                    <div class="summary-line"><span>Issues + PRs</span><strong>@_project.Repository.OpenIssuesCount.ToString("N0")</strong></div>
                </div>
            }

            <div class="sidebar-footer">
                <span class="status-dot"></span>
                <span>Los datos se obtienen directamente de GitHub</span>
            </div>
        </aside>

        <main class="board-area">
            <div class="board-toolbar">
                <div class="board-breadcrumb">
                    <strong>@(_project?.Repository.Name ?? "Lienzo")</strong>
                </div>
                <div class="board-tools">
                    <span class="canvas-hint">Arrastra las tarjetas para organizarlas</span>
                    <div class="zoom-control" aria-label="Controles de zoom">
                        <button type="button" @onclick="ZoomOut" aria-label="Alejar">−</button>
                        <span>@($"{_zoom:P0}")</span>
                        <button type="button" @onclick="ZoomIn" aria-label="Acercar">＋</button>
                        <span class="tool-divider"></span>
                        <button type="button" class="fit-button" @onclick="ResetView" aria-label="Restablecer vista">⤢</button>
                    </div>
                    <button type="button" class="toolbar-print" @onclick="PrintBoard" aria-label="Imprimir tablero">
                        <span aria-hidden="true">⎙</span><span>Imprimir</span>
                    </button>
                </div>
            </div>

            @if (_project is not null)
            {
                <CanvasBoard @ref="_canvasBoard" Project="_project" Zoom="_zoom" ZoomChanged="SetZoom" />
            }
            else if (!_isLoading)
            {
                <div class="empty-canvas">
                    <div class="empty-illustration" aria-hidden="true">
                        <div class="empty-card empty-card-left"></div>
                        <div class="empty-card empty-card-main"><span></span><span></span><span></span></div>
                        <div class="empty-card empty-card-right"></div>
                        <div class="empty-connector"></div>
                    </div>
                    <span class="eyebrow">TU ESPACIO DE TRABAJO</span>
                    <h2>Las ideas de tu proyecto, en un solo lugar</h2>
                    <p>Escribe <strong>usuario/repositorio</strong> para convertir los datos de GitHub en un tablero interactivo.</p>
                    <button class="primary-button empty-action" type="button" @onclick="LoadProjectAsync">Probar con dotnet/aspnetcore</button>
                </div>
            }
            else
            {
                <div class="loading-canvas" role="status">
                    <span class="large-spinner" aria-hidden="true"></span>
                    <strong>Preparando tu tablero…</strong>
                    <span>Consultando la información pública del repositorio</span>
                </div>
            }
        </main>
    </div>
</div>

@if (_showConnectionDialog)
{
    <div class="connection-dialog-backdrop" role="presentation" @onclick="CloseConnectionDialog">
        <section class="connection-dialog" role="dialog" aria-modal="true" aria-labelledby="connection-dialog-title"
                 @onclick:stopPropagation="true">
            <div class="connection-dialog-heading">
                <div>
                    <span class="eyebrow">MÁS CONSULTAS, MISMO ACCESO PÚBLICO</span>
                    <h2 id="connection-dialog-title">Conectar GitHub</h2>
                </div>
                <button class="expanded-close" type="button" @onclick="CloseConnectionDialog"
                        aria-label="Cerrar diálogo">×</button>
            </div>
            <p>
                Usa un token personal de acceso <strong>fine-grained</strong> con acceso
                <strong>solo de lectura a repositorios públicos</strong>. El token solo se conserva
                en la memoria de esta pestaña y se elimina al desconectar o recargarla.
            </p>
            <a class="token-help-link" href="https://github.com/settings/personal-access-tokens/new"
               target="_blank" rel="noopener noreferrer">Crear un token en GitHub ↗</a>
            <form class="connection-form" @onsubmit="ConnectGitHubAsync" @onsubmit:preventDefault>
                <label for="github-token">Token personal</label>
                <input id="github-token" type="password" @bind="_tokenInput" autocomplete="off"
                       autocapitalize="off" spellcheck="false" placeholder="Introduce tu token fine-grained" />
                @if (_connectionError is not null)
                {
                    <div class="error-message" role="alert">@_connectionError</div>
                }
                <div class="connection-dialog-actions">
                    <button class="secondary-button" type="button" @onclick="CloseConnectionDialog">Cancelar</button>
                    <button class="primary-button" type="submit"
                            disabled="@(_isConnecting || string.IsNullOrWhiteSpace(_tokenInput))">
                        @if (_isConnecting)
                        {
                            <span class="button-spinner" aria-hidden="true"></span>
                            <span>Verificando…</span>
                        }
                        else
                        {
                            <span>Conectar</span>
                        }
                    </button>
                </div>
            </form>
            <p class="connection-security-note">
                La app consulta <code>api.github.com</code> directamente; nunca envía el token a un servidor de RepoCanvas.
                No uses un token con acceso de escritura.
            </p>
        </section>
    </div>
}

@code {
    private const double DefaultZoom = 0.58;

    private static readonly Regex RepositoryPattern = new(
        @"^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$",
        RegexOptions.Compiled | RegexOptions.CultureInvariant);

    private string _repositoryInput = "dotnet/aspnetcore";
    private GitHubProjectData? _project;
    private CanvasBoard? _canvasBoard;
    private string? _error;
    private string? _connectionError;
    private string _tokenInput = string.Empty;
    private bool _isLoading;
    private bool _isConnecting;
    private bool _showConnectionDialog;
    private double _zoom = DefaultZoom;

    protected override async Task OnInitializedAsync() => await LoadProjectAsync();

    private async Task LoadProjectAsync()
    {
        var repository = _repositoryInput.Trim();
        if (!RepositoryPattern.IsMatch(repository))
        {
            _error = "Escribe el repositorio con el formato usuario/repositorio.";
            return;
        }

        var segments = repository.Split('/');
        _isLoading = true;
        _error = null;

        try
        {
            _project = await ProjectService.GetProjectAsync(segments[0], segments[1]);
            _zoom = DefaultZoom;
        }
        catch (HttpRequestException exception)
        {
            _project = null;
            _error = exception.StatusCode switch
            {
                HttpStatusCode.NotFound => "No se encontró el repositorio. Comprueba el nombre y que sea público.",
                HttpStatusCode.Forbidden => ApiSession.Usage.IsAuthenticated
                    ? "GitHub rechazó la consulta o alcanzó el límite de esta cuenta. Comprueba el token y el límite restante."
                    : "GitHub limitó las consultas anónimas. Conecta una cuenta o espera a que se restablezca el límite.",
                _ => $"No se pudo cargar el repositorio: {exception.Message}"
            };
        }
        catch (InvalidOperationException exception)
        {
            _project = null;
            _error = exception.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenConnectionDialog()
    {
        _connectionError = null;
        _showConnectionDialog = true;
    }

    private void CloseConnectionDialog()
    {
        _showConnectionDialog = false;
        _connectionError = null;
        _tokenInput = string.Empty;
    }

    private async Task ConnectGitHubAsync()
    {
        _isConnecting = true;
        _connectionError = null;
        try
        {
            await ApiSession.ConnectAsync(_tokenInput);
            _tokenInput = string.Empty;
            _showConnectionDialog = false;
        }
        catch (InvalidOperationException exception)
        {
            _connectionError = exception.Message;
        }
        catch (HttpRequestException)
        {
            _connectionError = "No se pudo verificar el token con GitHub. Comprueba tu conexión e inténtalo de nuevo.";
        }
        finally
        {
            _isConnecting = false;
        }
    }

    private void DisconnectGitHub() => ApiSession.Disconnect();

    private async Task PrintBoard() => await JS.InvokeVoidAsync("print");

    private void ZoomIn() => SetZoom(Math.Min(1.35, _zoom + 0.1));
    private void ZoomOut() => SetZoom(Math.Max(0.55, _zoom - 0.1));
    private void ResetView()
    {
        SetZoom(DefaultZoom);
        _canvasBoard?.ResetView();
    }
    private void SetZoom(double value) => _zoom = Math.Clamp(value, 0.55, 1.35);
}
